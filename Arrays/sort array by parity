class Solution {
    public int[] sortArrayByParity(int[] nums) {
       int n = nums.length;
        int i = 0;
        int j = n-1;
        int temp = 0;
        while(i<j){
            if(nums[i] % 2 != 0 && nums[j] %2 == 0){
               temp = nums[i];
               nums[i] = nums[j];
               nums[j] = temp;
               i++;
               j--;
            }else if(nums[i] %2 == 0){
                i++;
            }else if(nums[j] %2 != 0){
                j--;
            }
        }
        return nums;
    }
}
