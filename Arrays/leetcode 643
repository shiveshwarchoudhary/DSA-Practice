class Solution {
    public double findMaxAverage(int[] nums, int k) {
      int n = nums.length;
        double maxAvg = Double.NEGATIVE_INFINITY;   // ✅ Initialization
      int left = 0;
      long sum = 0;

      for(int right  = 0 ; right<n ; right++){

        sum += nums[right];
        if(right - left + 1 == k){
            double avg = (double) sum/k;
          maxAvg = Math.max (maxAvg , avg);
     
         sum -= nums[left];
         left++;
          

        }
      } 
      return maxAvg;  
    }
}
