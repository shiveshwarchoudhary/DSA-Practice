class Solution {
    public int threeSumClosest(int[] nums, int target) {
      int n = nums.length;
      Arrays.sort(nums);
      
      // Initial closest sum set karo
     int closestSum = nums[0] + nums[1] + nums[2];
      for(int i = 0; i<n-2; i++){
        // edge case 
        if(i>0 &&  nums[i] == nums[i-1]){
            continue;
        }
        int left = i+1;
        int right = n-1;
        // if sum == target
        
                while(left < right){
                    int sum = nums[i]+nums[left]+nums[right];

                    if (sum == target) {
                 return sum;
                }
                
      // closestSum update karo
       if (Math.abs(sum - target) < Math.abs(closestSum - target)) {
          closestSum = sum;
         }
         // for  Move pointers
        if(sum < target){
            left++;
        }else {
            right--;
        }
}
      }
      return closestSum;
}
}
